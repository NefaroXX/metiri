<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Camera is mandatory; ARCore is NOT (plan 15.3 single universal APK):
         ARCore-uncertified devices (e.g. Redmi 10C) install and run the same
         APK on the sensor provider. See docs/setup.md. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera.ar"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ARCore install-time gating OFF (plan 15.3): AR optional, so the
             single universal APK installs on certified and uncertified devices
             alike; the runtime SpatialProvider decides which pipeline runs. -->
        <meta-data
            android:name="com.google.ar.core"
            android:value="optional" />
    </application>

</manifest>
